{
  "manifest_version": 3,
  "name": "VoiceClip",
  "description": "Copy, cut, select, and paste page text by voice: “copy from FaceTime to location”.",
  "version": "1.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["parser.js", "textmatch.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "toolbar-16.png",
      "32": "toolbar-32.png"
    }
  },
  "permissions": ["nativeMessaging", "storage"]
}
