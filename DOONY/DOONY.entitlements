<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Turns on the Data Protection capability; NSFileProtectionComplete is the
         default class applied to newly created files. The SwiftData store is
         downgraded to CompleteUntilFirstUserAuthentication in code so background
         location writes can occur while the device is locked. -->
    <key>com.apple.developer.default-data-protection</key>
    <string>NSFileProtectionComplete</string>
</dict>
</plist>
